# Contoh environment variable — JANGAN isi nilai asli di file ini.
# Salin file ini menjadi .env.local lalu isi nilai asli di .env.local saja.
# File .env.local TIDAK boleh di-commit ke GitHub (sudah di-.gitignore).

# Mode demo: true = pakai data contoh di memori (tanpa Google). false = pakai Google Sheets & Drive asli.
USE_MOCK=true

# ID Spreadsheet Google & ID Folder Google Drive arsip surat
GOOGLE_SPREADSHEET_ID=
GOOGLE_DRIVE_FOLDER_ID=

# --- OPSI A (REKOMENDASI UNTUK AKUN @gmail.com GRATIS 15 GB) ---
# OAuth2 Refresh Token agar upload PDF memakai kuota 15 GB akun Gmail sekolah (bebas error kuota 0 byte Service Account)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# --- OPSI B (OPSIONAL UNTUK GOOGLE WORKSPACE @sch.id SHARED DRIVE) ---
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=

# Salt untuk hash PIN ('h' + SHA256(SALT + pin)) — salin persis nilai SALT dari Script Properties Apps Script lama
# agar seluruh PIN Admin & Pegawai di Spreadsheet lama langsung berlaku tanpa reset!
SALT=

# Rahasia penandatangan cookie sesi login (minimal 32 karakter acak; jika kosong akan memakai SALT)
SESSION_SECRET=
