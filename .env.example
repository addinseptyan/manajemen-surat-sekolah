# Contoh environment variable — JANGAN isi nilai asli di file ini.
# Salin file ini menjadi .env.local lalu isi nilai asli di .env.local saja.
# File .env.local TIDAK boleh di-commit ke GitHub (sudah di-.gitignore).

# Mode demo: true = pakai data contoh tanpa Google. false = pakai Google Sheets/Drive asli.
USE_MOCK=true

# ID Spreadsheet Google (diisi saat backend Google disambungkan)
GOOGLE_SPREADSHEET_ID=
# ID Folder Google Drive untuk menyimpan file surat
GOOGLE_DRIVE_FOLDER_ID=
# Email Service Account Google
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Private key Service Account (satu baris, ganti \n dengan \\n bila perlu)
GOOGLE_PRIVATE_KEY=

# Salt untuk hash PIN ('h' + SHA256(SALT + pin)) — salin nilai SALT dari Script Properties Apps Script lama
# agar seluruh PIN pegawai di Spreadsheet lama langsung berlaku tanpa reset!
SALT=

# Rahasia penandatangan cookie sesi login (minimal 32 karakter acak; jika dikosongkan akan memakai SALT)
SESSION_SECRET=
